{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:donebot:catalog:v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gateway_contract_version",
    "catalog_scope_id",
    "catalog_version",
    "defaults",
    "models"
  ],
  "properties": {
    "gateway_contract_version": {
      "const": 3
    },
    "catalog_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "control",
        "levels",
        "default",
        "native_field"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "control": {
          "enum": [
            "none",
            "effort",
            "budget",
            "variant"
          ]
        },
        "levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "supported": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "control": {
                "const": "none"
              },
              "levels": {
                "maxItems": 0
              },
              "default": {
                "const": null
              },
              "native_field": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "control": {
                "enum": [
                  "effort",
                  "budget",
                  "variant"
                ]
              },
              "levels": {
                "minItems": 1
              },
              "native_field": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "budget"
              }
            }
          },
          "then": {
            "required": [
              "mapping"
            ],
            "properties": {
              "mapping": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "variant"
              }
            }
          },
          "then": {
            "required": [
              "mapping"
            ],
            "properties": {
              "mapping": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency"
      ],
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "output_per_million": {
          "type": "number",
          "minimum": 0
        },
        "per_request": {
          "type": "number",
          "minimum": 0
        },
        "image_sizes": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "media_types",
        "platforms",
        "interfaces",
        "capabilities",
        "pricing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image",
              "video",
              "music",
              "audio"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_calling",
            "reasoning"
          ],
          "properties": {
            "tool_calling": {
              "type": "boolean"
            },
            "input_modalities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["text", "image", "audio", "video"]
              }
            },
            "context_window_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "reasoning": {
              "$ref": "#/$defs/reasoning"
            },
            "by_interface": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/reasoning"
              }
            }
          }
        },
        "pricing": {
          "$ref": "#/$defs/price"
        },
        "media_parameters": {
          "$ref": "#/$defs/media_parameters"
        }
      }
    },
    "media_protocol": {
      "oneOf": [
        {
          "const": {
            "adapter": "openai.images.v1",
            "submit": {
              "method": "POST",
              "path": "/v1/images/generations",
              "content_type": "application/json",
              "response_kind": "json"
            }
          }
        },
        {
          "const": {
            "adapter": "apimart.images.v1",
            "submit": {
              "method": "POST",
              "path": "/v1/images/generations",
              "content_type": "application/json",
              "response_kind": "json"
            },
            "task_id_path": "data.0.task_id",
            "poll": {
              "method": "GET",
              "path": "/v1/tasks/{task_id}",
              "response_kind": "json",
              "status_paths": [
                "data.status",
                "status"
              ],
              "completed_statuses": [
                "success"
              ],
              "failed_statuses": [
                "failed",
                "cancelled"
              ],
              "result_paths": [
                "data.result.images",
                "result.images"
              ]
            }
          }
        },
        {
          "const": {
            "adapter": "apimart.music.v1",
            "submit": {
              "method": "POST",
              "path": "/v1/music/generations",
              "content_type": "application/json",
              "response_kind": "json"
            },
            "task_id_path": "data.0.task_id",
            "poll": {
              "method": "GET",
              "path": "/v1/music/tasks/{task_id}",
              "response_kind": "json",
              "status_paths": [
                "data.status",
                "status"
              ],
              "completed_statuses": [
                "completed"
              ],
              "failed_statuses": [
                "failed",
                "cancelled"
              ],
              "result_paths": [
                "data.result.music",
                "result.music"
              ]
            }
          }
        },
        {
          "const": {
            "adapter": "apimart.speech.v1",
            "submit": {
              "method": "POST",
              "path": "/v1/audio/speech",
              "content_type": "application/json",
              "response_kind": "binary"
            }
          }
        },
        {
          "const": {
            "adapter": "seedance.videos.v1",
            "submit": {
              "method": "POST",
              "path": "/v1/videos",
              "content_type": "application/json",
              "response_kind": "json"
            },
            "task_id_path": "id",
            "poll": {
              "method": "GET",
              "path": "/v1/videos/{task_id}",
              "response_kind": "json",
              "status_paths": [
                "status"
              ],
              "completed_statuses": [
                "succeeded"
              ],
              "failed_statuses": [
                "failed",
                "cancelled",
                "expired"
              ],
              "result_paths": [
                "content.video_url"
              ]
            },
            "content": {
              "method": "GET",
              "path": "/v1/videos/{task_id}/content",
              "response_kind": "binary"
            }
          }
        }
      ]
    },
    "media_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol"
      ],
      "properties": {
        "sizes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "aspect_ratios": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "resolutions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "voices": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "music_versions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^/\\\\{}\\r\\n\\t]+$"
          }
        },
        "duration_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "automatic": {
              "type": "boolean"
            },
            "requires_custom": {
              "type": "boolean"
            }
          }
        },
        "protocol": {
          "$ref": "#/$defs/media_protocol"
        }
      }
    }
  }
}

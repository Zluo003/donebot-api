        "image"
      ],
      "platforms": [
        "fixture"
      ],
      "interfaces": [
        "openai.images"
      ],
      "capabilities": {
        "tool_calling": false,
        "reasoning": {
          "supported": false,
          "control": "none",
          "levels": [],
          "default": null,
          "native_field": null
        }
      },
      "pricing": {
        "currency": "CNY",
        "image_sizes": {
          "1K": 0.2,
          "2K": 0.4
        }
      },
      "media_parameters": {
        "sizes": [
          "auto",
          "1K",
          "1.5K",
          "2K"
        ],
        "aspect_ratios": [
          "1:1",
          "16:9",
          "9:16"
        ],
        "resolutions": [
          "1K",
          "1.5K",
          "2K"
        ],
        "protocol": {
          "adapter": "apimart.images.v1",
          "submit": {
            "method": "POST",
            "path": "/v1/images/generations",
            "content_type": "application/json",
            "response_kind": "json"
          },
          "task_id_path": "data.0.task_id",
          "poll": {
            "method": "GET",
            "path": "/v1/tasks/{task_id}",
            "response_kind": "json",
            "status_paths": [
              "data.status",
              "status"
            ],
            "completed_statuses": [
              "success"
            ],
            "failed_statuses": [
              "failed",
              "cancelled"
            ],
            "result_paths": [
              "data.result.images",
              "result.images"
            ]
          }
        }
      }
    },

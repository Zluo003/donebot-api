    {
      "id": "fixture-chat",
      "display_name": "Fixture Chat",
      "media_types": [
        "text"
      ],
      "platforms": [
        "openai"
      ],
      "interfaces": [
        "openai.chat_completions"
      ],
      "capabilities": {
        "context_window_tokens": 200000,
        "max_output_tokens": 8192,
        "tool_calling": true,
        "reasoning": {
          "supported": true,
          "control": "effort",
          "levels": [
            "low",
            "medium",
            "high"
          ],
          "default": null,
          "native_field": "reasoning_effort"
        }
      },
      "pricing": {
        "currency": "CNY",
        "input_per_million": 1,
        "output_per_million": 2
      }
    },

          "minLength": 1,
          "maxLength": 80
        },
        "featured": {
          "type": "boolean"
        },
        "tags": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "outcomes": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "setupMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240

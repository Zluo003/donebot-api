                      "expression": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "type",
                      "expression",
                      "timeZone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "once"
                      },
                      "at": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "type",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "daily"
                      },
                      "time": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5,
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "weekdays": {
                        "minItems": 1,
                        "maxItems": 7,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        }
                      }
                    },
                    "required": [
                      "type",
                      "time",
                      "weekdays"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "interval"
                      },
                      "everyMinutes": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 1440
                      },
                      "anchorAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8640000000000000

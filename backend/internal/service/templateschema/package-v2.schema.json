  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "openmaus.package"
    },
    "version": {
      "type": "number",
      "const": 2
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "release": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {}
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80

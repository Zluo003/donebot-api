              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {}
                ]
              },
              "soul": {
                "type": "string"
              },
              "appearance": {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string",
                    "enum": [
                      "green",
                      "blue",
                      "red",
                      "orange",
                      "purple",
                      "cyan",
                      "pink",
                      "yellow",
                      "teal",
                      "coral",
                      "silver",
                      "chrome"
                    ]
                  },
                  "mascotExpression": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      },
                      {}
                    ]
                  },
                  "mascotBody": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
